<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- consent settings for the JS adapter - in <head>, before any script -->
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="ck.consent.config"
                   template="CommerceKings_Consent::consent-config.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">CommerceKings\Consent\ViewModel\ConsentConfig</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
