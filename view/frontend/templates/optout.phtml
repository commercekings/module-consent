<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \CommerceKings\Consent\ViewModel\Withdrawal $viewModel */
$viewModel = $block->getData('view_model');
?>
<div class="ck-optout" style="max-width: 560px; margin: 20px auto 40px; text-align: center;">
    <?php if (!$viewModel->hasWithdrawnConsent()): ?>
    <?php if ($viewModel->isOriginalBrowser()): ?>
    <p><?= $escaper->escapeHtml(__('Withdraw your consent for "%purpose"?', ['purpose' => $viewModel->getPurposeLabel()])) ?></p>
    <?php else: ?>
    <p><?= $escaper->escapeHtml(__('Withdraw the consent linked to this message?')) ?></p>
    <?php endif; ?>
    <p><?= $escaper->escapeHtml(__('Nothing changes until you confirm.')) ?></p>
    <?php elseif ($viewModel->hasNewerConsent()): ?>
    <p><?= $escaper->escapeHtml(__('Your earlier consent for "%purpose" was already withdrawn.', ['purpose' => $viewModel->getPurposeLabel()])) ?></p>
    <p><?= $escaper->escapeHtml(__('Your newer consent remains active. You can turn it off in cookie settings.')) ?></p>
    <?php else: ?>
    <p><?= $escaper->escapeHtml(__('Your consent for "%purpose" has been withdrawn.', ['purpose' => $viewModel->getPurposeLabel()])) ?></p>
    <p><?= $escaper->escapeHtml(__('You can change your preferences in the cookie settings.')) ?></p>
    <?php endif; ?>
    <?php if ($viewModel->canConfirm()): ?>
    <form id="ckconsent-optout-form" action="<?= $escaper->escapeUrl($block->getUrl('ckconsent/optout')) ?>" method="post">
        <?= $block->getBlockHtml('formkey') ?>
        <input type="hidden" name="c" value="<?= $escaper->escapeHtmlAttr($viewModel->getConsentId()) ?>"/>
        <input type="hidden" name="t" value="<?= $escaper->escapeHtmlAttr($viewModel->getToken()) ?>"/>
        <button class="action primary" type="submit"><span><?= $escaper->escapeHtml(
            $viewModel->hasWithdrawnConsent() ? __('Apply withdrawal in this browser') : __('Withdraw consent')
        ) ?></span></button>
    </form>
    <?php endif; ?>
    <a class="action primary" href="<?= $escaper->escapeUrl($block->getUrl('')) ?>"><?= $escaper->escapeHtml(__('Back to the store')) ?></a>
</div>
<script type="text/x-magento-init" id="commercekings-consent-withdrawal"><?= /* @noEscape */ $viewModel->getBannerConfigJson() ?></script>
