<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="commercekings" translate="label" sortOrder="900" class="commercekings-tab">
            <label>CommerceKings</label>
        </tab>
        <section id="commercekings_consent" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Consent</label>
            <tab>commercekings</tab>
            <resource>CommerceKings_Consent::config</resource>
            <group id="general" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1">
                <label>Consent</label>
                <comment>Choose a cookie banner and manage consent records. Clear the full-page cache after changes.</comment>
                <field id="source" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Cookie banner</label>
                    <comment>None disables the banner and consent. Changing banners invalidates earlier consent.</comment>
                    <source_model>CommerceKings\Consent\Model\Config\Source\Sources</source_model>
                </field>
                <field id="privacy_url" translate="label comment" type="text" sortOrder="11" showInDefault="1" showInWebsite="1">
                    <label>Privacy policy page</label>
                    <comment>Page URL key or full URL. Linked from the banner.</comment>
                </field>
                <field id="source_version" translate="label comment" sortOrder="12" showInDefault="1" showInWebsite="1">
                    <label>Banner version</label>
                    <comment>Version supplied by the selected banner.</comment>
                    <frontend_model>CommerceKings\Consent\Block\Adminhtml\SourceInfo</frontend_model>
                </field>
                <field id="cookie_name" translate="label comment" type="text" sortOrder="13" showInDefault="1" showInWebsite="1">
                    <label>Consent cookie name</label>
                    <comment>Changing the name asks visitors for consent again.</comment>
                    <validate>required-entry validate-code</validate>
                </field>
                <field id="source_categories" translate="label comment" sortOrder="16" showInDefault="1" showInWebsite="1">
                    <label>Banner categories</label>
                    <comment>Visitor choices, linked purposes and cookies cleared on withdrawal.</comment>
                    <frontend_model>CommerceKings\Consent\Block\Adminhtml\SourceInfo</frontend_model>
                </field>
                <field id="record_purposes" translate="label comment" type="CommerceKings\Consent\Block\Adminhtml\Form\Element\RecordPurposes" sortOrder="17" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Record consent for</label>
                    <comment>Required purposes are always recorded. Select other purposes to save consent evidence.</comment>
                    <source_model>CommerceKings\Consent\Model\Config\Source\RecordPurposes</source_model>
                    <can_be_empty>1</can_be_empty>
                    <depends>
                        <field id="source" negative="1"/>
                    </depends>
                </field>
                <field id="one_click_unsubscribe" translate="label comment" type="select" sortOrder="875" showInDefault="1" showInWebsite="1">
                    <label>One-click unsubscribe</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds an unsubscribe option in supported email apps. Requires DKIM signing by your mail provider.</comment>
                </field>
                <field id="revision" translate="label comment" type="text" sortOrder="880" showInDefault="1" showInWebsite="1">
                    <label>Banner revision</label>
                    <comment>Increase to ask all visitors again and invalidate earlier consent.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="wording_check" translate="label comment" sortOrder="885" showInDefault="1" showInWebsite="1">
                    <label>Banner text status</label>
                    <comment>Shows text changes since this revision was first accepted.</comment>
                    <frontend_model>CommerceKings\Consent\Block\Adminhtml\WordingCheck</frontend_model>
                </field>
                <field id="cookie_lifetime_days" translate="label comment" type="text" sortOrder="890" showInDefault="1" showInWebsite="1">
                    <label>Consent lifetime (days)</label>
                    <comment>Maximum age of a saved choice. Reducing this also shortens existing consent.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="keep_days" translate="label comment" type="text" sortOrder="900" showInDefault="1">
                    <label>Record retention (days)</label>
                    <comment>Days to keep evidence after expiry or withdrawal. Withdrawal markers may be kept longer.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
