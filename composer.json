{
    "name": "commercekings/module-consent",
    "description": "Generic consent layer for Magento 2: purposes, pluggable consent sources (cookie banners, ...), consent time, browser identity and withdrawals.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "commercekings/module-core": "^0.1",
        "magento/framework": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-cms": "^104.0",
        "magento/module-config": "^101.2",
        "magento/module-import-export": "^101.0",
        "magento/module-eav": "^102.1",
        "magento/module-backend": "^102.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\Consent\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-consent",
    "support": {
        "issues": "https://github.com/commercekings/module-consent/issues",
        "source": "https://github.com/commercekings/module-consent"
    }
}
